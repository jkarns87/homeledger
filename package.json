{
  "name": "homeledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "smoke": "pnpm --filter @homeledger/scripts smoke",
    "manuals": "pnpm --filter @homeledger/scripts manuals"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
