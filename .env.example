AWS_REGION=us-east-1
HOUSEHOLD_ID=hh_harlow
TABLE_NAME=homeledger
DYNAMO_ENDPOINT=http://127.0.0.1:8000
HOMELEDGER_DEV_TOOLS=1
# Empty is meaningful here: ask_manual falls back to the in-memory fixture
# retriever, which is the documented local behaviour.
KNOWLEDGE_BASE_ID=
AVAILABILITY_DELAY_MS=600
# Empty is NOT meaningful here. apps/mcp-server/src/deps.ts treats an
# explicitly-set-but-empty value as a deployment misconfiguration and refuses
# to start: it must be at least 32 bytes, or you get
# "REQUEST_STATE_KEY must be at least 32 bytes" and no server. Replace the
# placeholder below - e.g. `openssl rand -base64 48` - or delete the line
# entirely, which makes the server mint a per-process key instead.
REQUEST_STATE_KEY=replace-me-with-at-least-32-bytes-of-random-value

# --- apps/simulator ---
# The simulator's agent runs on the Anthropic API, NOT on Bedrock: Bedrock model
# invocation is refused account-wide on this account (FRICTION-LOG.md FL-019),
# so a Bedrock-backed agent could not make one call. Put the real key in
# apps/simulator/.env.local, which is git-ignored; this file is committed.
ANTHROPIC_API_KEY=
HOMELEDGER_SIMULATOR_MODEL=claude-sonnet-5
HOMELEDGER_SIMULATOR_MAX_ROUNDS=8
HOMELEDGER_SIMULATOR_ELICITATION_TIMEOUT_MS=120000
# Unset keeps the strict default: loopback Host only, and an Origin (when sent) must match it.
# Set it to the one origin you expect when opening the simulator from another machine or a proxy.
HOMELEDGER_SIMULATOR_ALLOW_ORIGIN=
# Set to a loopback MCP server URL (e.g. http://127.0.0.1:8010/mcp) with
# HOMELEDGER_COGNITO_TOKEN_URL left unset to talk to a local server with no
# bearer token at all — see isUnauthenticatedLocal in src/server/credentials.ts.
# Unset (the default) resolves the deployed runtime by name instead.
HOMELEDGER_MCP_URL=
# '1' answers from a fixed script instead of the model — used by the
# Playwright suite (pnpm test:e2e) and nowhere else. Any other value, empty
# string included, runs the real model.
HOMELEDGER_SIMULATOR_SCRIPTED_MODEL=
